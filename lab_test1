# Create two data frames: orders with columns OrderID, CustomerID, and Amount. The  CustomerID should be a mix of C01 to C05; and; 
orderid <- c("112","113","114","115","116")
custid <- c("c01","c02","c03","c04","c05")
amt <- c(100,200,300,400,500)


#customer_info with columns CustomerID, and Name. Ensure that CustomerID values match  those in orders
orders <- data.frame(orderid,custid,amt)
name <- c("geetika","geet","aashika","shreeya","sneha")
customer_info <-data.frame(name,custid)


#Merge these two data frames into a single data frame named full_orders so that each row  contains the customer name alongside the order amount. 
full_order <- merge(orders,customer_info,by ="custid")
print("The merge dataframe is:")
print(full_order)


