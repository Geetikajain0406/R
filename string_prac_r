 remove_dup <- function(s) {
    s <- tolower(s)
    words <- strsplit(s, " ")[[1]]
    uni<- unique(words)
    return (paste(uni, collapse = " "))

}
s <- "Python for Data Analysis, Data Analytics, Business Analytics"
print(remove_dup(s))

