is_prime <- function(n){
        if (n < 2){
            return(FALSE)
        }
        for (i in 2:(n-1)){
            if(n %% i == 0)
            return(FALSE)
        }
    return(TRUE)
}
num <- c(3, 4, 5, 6, 7, 8, 9, 10)
for(n in num){
    print(is_prime(n))
