rev_list <- function(lst){
    res <- c()
    for(i in length(lst):1){
        res <- c(res , lst[i])
    }
    return(res)
}
print(rev_list(c(1,2,3,4)))


count_vowel <- function(s){
    s <- tolower(s)
    count <- 0
    for(i in 1:nchar(s)){
        ch <- substr(s,i,i)
    
    if(ch %in% c("a","e","i","o","u")){
        count <- count+1
    }
    }
    return(count)
}
print(count_vowel("hello world"))

