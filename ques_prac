class <- data.frame(
    Student = c("S01","S02","SO3", "SO4", "S05"),
    Marks = c(72, 85, 64, 91, 78),
    Attendance = c(82, 90, 75, 95, 88)
)
print(class)
class$res <- ""
for(i in 1:nrow(class)){
        if(class$Marks[i]>=50){
            class$res[i]<-"PASS"
            }
            else{
                class$res[i]<-"FAIL"
                }
}
print(class)
avg <- mean(class$Marks)
print(avg)
for(i in 1:nrow(class)){
    if(class$Marks[i]>avg){
        print(class$Marks[i])
    }
}
highest <- max(class$Marks)
print(highest)



